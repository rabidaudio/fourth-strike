- {songwriter: 'Songwriters', contributor: 'Contributors', associated: 'Associated artists'}.each do |level, title|
  - cc = track.contributions.where(level: level)
  - unless cc.empty?
    span.has-text-weight-bold = title
    ul
      - cc.each do |contribution|
        li
          a href=artist_path(contribution.artist_id) = contribution.artist.name
          - if contribution.details.present?
            span = " (#{contribution.details})"
